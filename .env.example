APP_NAME=AutoFlow
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./autoflow.db
PLATFORM_ADMIN_EMAIL=your-admin-email@example.com
# Email verification (SMTP). In development without SMTP, the code is written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
